# .external-credentials.example
#
# Copy this file to `.external-credentials` (gitignored) at the working-project
# root, fill in your real values, and NEVER commit the filled file.
#
# The UC5 ops connector skills (aws, bitbucket-pipeline, cloudflare) read these
# sections at runtime. All tokens MUST be read-only scoped.

[aws]
profile=<your-aws-profile>
region=<your-region>

[bitbucket]
workspace=<your-workspace>
repo_slug=<your-repo>
email=<your-email>
api_token=<read-only-scoped-bitbucket-token>

[cloudflare]
account_id=<cloudflare-account-id>
zone_id=<your-zone-id>
api_token=<read-only-scoped-cloudflare-token>
