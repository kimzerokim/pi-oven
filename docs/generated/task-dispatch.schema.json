        "pov:planner",
        "pov:code-reviewer",
        "pov:debugger",
        "pov:test-engineer",
        "pov:security-reviewer",
        "pov:writer",
        "pov:designer",
        "pov:code-simplifier",
        "pov:qa-tester",
        "pov:git-master",
        "pov:document-specialist",
        "pov:tracer",
        "pov:analyst",
        "pov:architect",
        "pov:librarian",
        "pov:multimodal-looker",
        "pov:oracle",
        "pov:metis",
        "pov:deep-researcher",
        "pov:data-runner"
