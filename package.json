{
  "name": "pi-oven",
  "version": "0.2.2",
  "private": true,
  "description": "Curated omp workflow + discipline layer (4-source successor)",
  "type": "module",
  "license": "MIT",
  "author": "kimzerokim <ky200223@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/kimzerokim/pi-oven.git"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "bun build .omp/extensions/pi-oven.ts --outdir dist --target bun --format esm --external '@oh-my-pi/*'",
    "eval": "bun scripts/run-eval.ts",
    "bench:runtime": "bun scripts/bench-runtime-injection.ts",
    "lint:agents": "bun scripts/lint-agents.ts",
    "lint:skills": "bun scripts/lint-skills.ts && bun --silent scripts/lint-doc-evidence.ts docs/harness/surveys/2026-07-05-pi-oven-remediation-detailed-survey.md docs/research/2026-07-05-pi-oven-codex-only-routing-research.md",
    "lint:doc-evidence": "bun --silent scripts/lint-doc-evidence.ts",
    "release:pi-oven": "bun scripts/pi-oven-release/index.ts"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "devDependencies": {
    "bun-types": "*",
    "typescript": "^5.5.0"
  },
  "omp": {
    "extensions": [
      "./.omp/extensions/pi-oven.ts"
    ]
  }
}
