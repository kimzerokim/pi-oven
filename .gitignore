# pi-oven runtime state (machine-readable, regeneratable)
.pi-oven/

# omp agent mirror — regenerated from SoT agents/ by the pi-oven extension
# (syncPiOvenAgentMirrors) on every session_start; never a load source. Keep
# .omp/extensions/ tracked (it is source); only the derived mirror is ignored.
.omp/agents/

# Harness working artifacts — per-session survey reports etc., regenerated on demand.
docs/harness/

# Claude Code local state / agent worktrees
.claude/

# omp local session state (Claude Code / OMC artifacts during bootstrap phase)
.omc/

# pi-agent local config (machine-local MCP servers etc.)
.pi/

# Node / Bun
node_modules/
dist/
.bun-cache/
*.log

# OS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/
*.iml

# Env / secrets
.env
.env.local
.env.*.local
*.key
*.pem
.external-credentials
.external_certificate
.external_cerficate

# Eval intermediate (per-run, transient)
evals/.runs/
evals/.tmp/

# Build artifacts
*.tsbuildinfo
coverage/

# Killer-feature test artifacts (arxiv/PDF reads, transient)
*.pdf

# omp local oven cache (machine-local)
.oven/
